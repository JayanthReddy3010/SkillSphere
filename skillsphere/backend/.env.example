# Copy to ".env" (same folder as pom.xml). The .env file is git-ignored.
# Values below are placeholders only.

DB_URL=jdbc:postgresql://localhost:5432/skillsphere_db
DB_USERNAME=postgres
DB_PASSWORD=change_me

SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# true when the site is served over HTTPS
COOKIE_SECURE=false

# Development only: prints password-reset links in the backend console
LOG_RESET_LINKS=true

# SMTP Mail Server Configuration (for OTP password reset emails)
# When SMTP_HOST is provided, real emails are sent using JavaMailSender.
# When left blank, dev mode logs delivery notifications to console without exposing the OTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_STARTTLS_REQUIRED=true
SMTP_FROM_EMAIL=no-reply@skillsphere.com
SMTP_FROM_NAME=SkillSphere Security

# OTP Configuration
OTP_HASH_SECRET=replace_with_a_secure_server_pepper_at_least_32_characters
OTP_ALLOW_DEV_FALLBACK=false
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RESET_TOKEN_LIFETIME_MINUTES=15

# Optional: creates the first Admin on startup if no Admin exists yet
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!2024
ADMIN_FULL_NAME=SkillSphere Administrator

# Google Gemini API key for Dynamic Skill Assessment generation and AI course recommendations.
# Create one free at https://aistudio.google.com/apikey  (never commit your real key)
# When this key is left blank or Gemini is unreachable, the system automatically activates
# the curated database-backed question bank fallback (marked with FALLBACK source).
GEMINI_API_KEY=
# Optional: Gemini model name (default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash
